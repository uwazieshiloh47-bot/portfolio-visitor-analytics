{
  "name": "portfolio-visitor-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "A learning-first serverless portfolio visitor analytics project.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test dist/test/**/*.test.js",
    "check": "npm run typecheck && npm run build && npm test",
    "invoke:hello": "npm run build && node scripts/invoke-hello.mjs"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1097.0",
    "@aws-sdk/lib-dynamodb": "^3.1097.0"
  }
}
